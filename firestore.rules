rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if owner() && request.auth.uid == userId;
    }
    match /products/{productId} { allow read, write: if owner(); }
    match /suppliers/{supplierId} { allow read, write: if owner(); }
    match /stock_movements/{movementId} { allow read, write: if owner(); }
    match /purchases/{purchaseId} { allow read, write: if owner(); }
    match /sales/{saleId} { allow read, write: if owner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
